# Copy to .env (never commit .env). Prefer GitHub Actions Secrets for automation.
# Two supported auth modes:

# MODE A - local installed-app OAuth (run `python automation/auth_setup.py` first)
GOOGLE_CLIENT_SECRET_JSON=/absolute/path/to/client_secret.json
GOOGLE_TOKEN_JSON=/absolute/path/to/token.json

# MODE B - headless / GitHub Actions: paste the JSON contents instead of paths
# YT_CLIENT_SECRET_JSON={"installed":{"client_id":"...","client_secret":"...","auth_uri":"...","token_uri":"..."}}
# YT_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","token_uri":"..."}

# Optional: channel id; if empty it is resolved via channels.list(mine=True)
YOUTUBE_CHANNEL_ID=

# Optional: local dedupe cache for comment replies (gitignored)
YT_STATE_PATH=state/replied.json
