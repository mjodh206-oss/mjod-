  "cues": [
    {
      "start": 0,
      "end": 93,
      "text": "في الرابع من ديسمبر عام 1872، رصد طاقم"
    },
    {
      "start": 93,
      "end": 181,
      "text": "السفينة البريطانية «دي غراتيا» سفينة"
    },
    {
      "start": 181,
      "end": 252,
      "text": "شراعية تبحر وحدها في الأطلسي."
    },
    {
      "start": 252,
      "end": 338,
      "text": "وفي صباح اليوم التالي، صعدوا إليها."
    },
    {
      "start": 338,
      "end": 434,
      "text": "لم تكن غارقة، لكن لم يكن على متنها أحد."
    },
    {
      "start": 434,
      "end": 527,
      "text": "قارب النجاة مفقود، وبعض الأشرعة متضرر."
    },
    {
      "start": 527,
      "end": 610,
      "text": "أما ركابها العشرة — القبطان وزوجته"
    },
    {
      "start": 610,
      "end": 713,
      "text": "وطفلتهما وسبعة بحّارة — فلم يُعثر على أيٍّ"
    },
    {
      "start": 713,
      "end": 742,
      "text": "منهم لاحقًا."
    },
    {
      "start": 742,
      "end": 808,
      "text": "اسم السفينة: «ماري سيليست»."
    },
    {
      "start": 808,
      "end": 908,
      "text": "ما الذي يدفع طاقمًا إلى ترك سفينة لا تزال"
    },
    {
      "start": 908,
      "end": 924,
      "text": "طافية؟"
    },
    {
      "start": 930,
      "end": 1008,
      "text": "غادرت ماري سيليست نيويورك في السابع من"
    },
    {
      "start": 1008,
      "end": 1078,
      "text": "نوفمبر، متجهة إلى جنوة في إيطاليا."
    },
    {
      "start": 1078,
      "end": 1150,
      "text": "كانت رحلة تجارية تنقل ألفًا وسبعمئة"
    },
    {
      "start": 1150,
      "end": 1228,
      "text": "وواحدًا من براميل الكحول الصناعي، وعلى"
    },
    {
      "start": 1228,
      "end": 1306,
      "text": "متنها أسرة القبطان بنجامين بريغز وطاقم"
    },
    {
      "start": 1306,
      "end": 1322,
      "text": "السفينة."
    },
    {
      "start": 1322,
      "end": 1406,
      "text": "لا تشير السجلات إلى أن الرحلة بدأت بوصفها"
    },
    {
      "start": 1406,
      "end": 1457,
      "text": "مغامرة أو مهمة استثنائية."
    },
    {
      "start": 1457,
      "end": 1543,
      "text": "في الخامس والعشرين من نوفمبر، دوّن القبطان"
    },
    {
      "start": 1543,
      "end": 1629,
      "text": "آخر ملاحظة معروفة قرب جزيرة سانتا ماريا في"
    },
    {
      "start": 1629,
      "end": 1643,
      "text": "الأزور."
    },
    {
      "start": 1643,
      "end": 1680,
      "text": "بعدها انقطع السجل."
    },
    {
      "start": 1680,
      "end": 1756,
      "text": "لا تخبرنا الملاحظة الأخيرة لماذا غادر"
    },
    {
      "start": 1756,
      "end": 1838,
      "text": "الركاب، ولا تقول إن السفينة كانت على وشك"
    },
    {
      "start": 1838,
      "end": 1853,
      "text": "الغرق."
    },
    {
      "start": 1859,
      "end": 1938,
      "text": "عندما صعد بحّارة دي غراتيا إلى ماري"
    },
    {
      "start": 1938,
      "end": 2026,
      "text": "سيليست، وجدوا أشرعة متضررة، ومضخة مفككة"
    },
    {
      "start": 2026,
      "end": 2091,
      "text": "جزئيًا، وماءً في قاع السفينة."
    },
    {
      "start": 2091,
      "end": 2163,
      "text": "لكنها بقيت طافية وقابلة للإبحار."
    },
    {
      "start": 2163,
      "end": 2248,
      "text": "قارب النجاة لم يكن في مكانه، بينما بقي"
    },
    {
      "start": 2248,
      "end": 2336,
      "text": "معظم ما عُثر عليه من الحمولة والمتعلقات"
    },
    {
      "start": 2336,
      "end": 2358,
      "text": "على متنها."
    },
    {
      "start": 2358,
      "end": 2450,
      "text": "قاد طاقم آخر السفينة لاحقًا إلى جبل طارق."
    },
    {
      "start": 2450,
      "end": 2538,
      "text": "هذه نقطة مهمة: لم تكن ماري سيليست سليمة"
    },
    {
      "start": 2538,
      "end": 2619,
      "text": "تمامًا، لكنها لم تكن حطامًا يوشك على"
    },
    {
      "start": 2619,
      "end": 2632,
      "text": "الغرق."
    },
    {
      "start": 2632,
      "end": 2722,
      "text": "أما سبب مغادرة من كانوا عليها، فلا تكشفه"
    },
    {
      "start": 2722,
      "end": 2761,
      "text": "الأشياء التي بقيت."
    },
    {
      "start": 2767,
      "end": 2856,
      "text": "في جبل طارق، خضعت السفينة لفحص وإجراءات"
    },
    {
      "start": 2856,
      "end": 2906,
      "text": "مرتبطة بعملية إنقاذها."
    },
    {
      "start": 2906,
      "end": 2995,
      "text": "وأثارت المكافأة المالية تساؤلات عن ظروف"
    },
    {
      "start": 2995,
      "end": 3025,
      "text": "العثور عليها."
    },
    {
      "start": 3025,
      "end": 3082,
      "text": "لكن الشك لا يساوي دليلًا."
    },
    {
      "start": 3082,
      "end": 3175,
      "text": "لم يثبت التحقيق وقوع هجوم أو مقتل الطاقم،"
    },
    {
      "start": 3175,
      "end": 3262,
      "text": "ولم يقدم سببًا مؤكدًا لمغادرة السفينة."
    },
    {
      "start": 3262,
      "end": 3351,
      "text": "ومع مرور السنين، أضيفت إلى القصة تفاصيل"
    },
    {
      "start": 3351,
      "end": 3444,
      "text": "درامية لا يسندها سجل موثوق، مثل مشهد طعام"
    },
    {
      "start": 3444,
      "end": 3485,
      "text": "متروك على المائدة."
    },
    {
      "start": 3485,
      "end": 3578,
      "text": "لذلك نعود إلى ما نعرفه: السفينة وُجدت بلا"
    },
    {
      "start": 3578,
      "end": 3671,
      "text": "ركاب، وقاربها مفقود، ومصير الأشخاص العشرة"
    },
    {
      "start": 3671,
      "end": 3692,
      "text": "لم يُحسم."
    },
    {
      "start": 3699,
      "end": 3794,
      "text": "طُرحت تفسيرات عدة، لكن لا واحدًا منها ثبت."
    },
    {
      "start": 3794,
      "end": 3880,
      "text": "ربما أقلق القبطان ارتفاع الماء أو تعطل"
    },
    {
      "start": 3880,
      "end": 3896,
      "text": "المضخة."
    },
    {
      "start": 3896,
      "end": 3982,
      "text": "وربما خشي من أبخرة شحنة الكحول، فاختار"
    },
    {
      "start": 3982,
      "end": 4072,
      "text": "الابتعاد عنها في قارب النجاة إلى أن تتضح"
    },
    {
      "start": 4072,
      "end": 4086,
      "text": "الحال."
    },
    {
      "start": 4086,
      "end": 4170,
      "text": "وقد يكون الطقس والبحر جعلا الرجوع إلى"
    },
    {
      "start": 4170,
      "end": 4220,
      "text": "السفينة أصعب مما توقع."
    },
    {
      "start": 4220,
      "end": 4306,
      "text": "هذه احتمالات معقولة، لكنها لا تشرح أين"
    },
    {
      "start": 4306,
      "end": 4347,
      "text": "انتهى ركاب القارب."
    },
    {
      "start": 4347,
      "end": 4435,
      "text": "كما أن الرياح والتيارات تساعد على تفسير"
    },
    {
      "start": 4435,
      "end": 4521,
      "text": "كيف واصلت ماري سيليست طريقها بلا طاقم؛"
    },
    {
      "start": 4521,
      "end": 4580,
      "text": "لكنها لا تكشف لماذا تُركت."
    },
    {
      "start": 4580,
      "end": 4670,
      "text": "وبين ما يمكن تخيله وما يمكن إثباته، تبقى"
    },
    {
      "start": 4670,
      "end": 4720,
      "text": "فجوة لا يملؤها التخمين."
    },
    {
      "start": 4727,
      "end": 4823,
      "text": "نعرف أين عُثر على ماري سيليست، ونعرف أنها"
    },
    {
      "start": 4823,
      "end": 4921,
      "text": "بقيت طافية، ونعرف أن قارب النجاة وركابه لم"
    },
    {
      "start": 4921,
      "end": 4951,
      "text": "يعودوا إليها."
    },
    {
      "start": 4951,
      "end": 5047,
      "text": "أمّا لماذا غادروا، وماذا حدث لهم بعد ذلك،"
    },
    {
      "start": 5047,
      "end": 5099,
      "text": "فلا جواب موثقًا لدينا."
    },
    {
      "start": 5099,
      "end": 5167,
      "text": "قد يكون البحر قد ابتلع القصة؛"
    },
    {
      "start": 5167,
      "end": 5247,
      "text": "وقد تكون هناك تفاصيل لم تصل إلينا."
    },
    {
      "start": 5247,
      "end": 5341,
      "text": "لكن ما نستطيع قوله بثقة أقل درامية وأكثر"
    },
    {
      "start": 5341,
      "end": 5434,
      "text": "صدقًا: السفينة عادت، واللغز بقي مفتوحًا."
    }
  ],
  "shortCues": [
    {
      "start": 0,
      "end": 94,
      "text": "في ديسمبر 1872، صعد بحّارة إلى سفينة"
    },
    {
      "start": 94,
      "end": 201,
      "text": "شراعية عثروا عليها تمضي وحدها في الأطلسي."
    },
    {
      "start": 201,
      "end": 308,
      "text": "كانت لا تزال طافية، لكن لا أحد على متنها،"
    },
    {
      "start": 308,
      "end": 358,
      "text": "وقارب النجاة مفقود."
    },
    {
      "start": 358,
      "end": 421,
      "text": "اسم السفينة ماري سيليست."
    },
    {
      "start": 421,
      "end": 523,
      "text": "كان على متنها عشرة أشخاص، بينهم القبطان"
    },
    {
      "start": 523,
      "end": 565,
      "text": "وزوجته وطفلتهما."
    },
    {
      "start": 565,
      "end": 661,
      "text": "آخر ملاحظة في سجلها كُتبت قرب الأزور؛"
    },
    {
      "start": 661,
      "end": 708,
      "text": "بعدها انقطع الخبر."
    },
    {
      "start": 708,
      "end": 742,
      "text": "ماء في القاع؟"
    },
    {
      "start": 742,
      "end": 773,
      "text": "مضخة متعطلة؟"
    },
    {
      "start": 773,
      "end": 825,
      "text": "خوف من أبخرة الشحنة؟"
    },
    {
      "start": 825,
      "end": 856,
      "text": "كلها فرضيات."
    },
    {
      "start": 856,
      "end": 965,
      "text": "لم يثبت سبب مغادرة السفينة، ولم يُعرف مصير"
    },
    {
      "start": 965,
      "end": 983,
      "text": "ركابها."
    },
    {
      "start": 983,
      "end": 1048,
      "text": "السفينة عادت إلى الميناء."
    },
    {
      "start": 1048,
      "end": 1100,
      "text": "الإجابة لم تعد معها."
    }
  ],
