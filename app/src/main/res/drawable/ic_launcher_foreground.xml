<?xml version="1.0" encoding="utf-8"?>
<!--
  مجودة mark: the assistant's orb — a teal→violet sphere wrapped in a thin orbit ring
  (back half dimmed behind the body, front half crisp in front), an amber comet
  riding the ring, and one 4-pointed spark. All art sits inside the Ø66 adaptive safe zone.
  Geometry (108 viewport): orb center (54,54) r=19.5; ring center (54,53.5) r=27.5.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back half of the orbit ring (behind the orb) -->
    <path android:pathData="M26.5,53.5 A27.5,27.5 0 0 1 81.5,53.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeWidth="3.3">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="82.5"
                android:endY="49"
                android:startX="25.5"
                android:startY="49"
                android:type="linear">
                <item android:color="#665EEAD4" android:offset="0" />
                <item android:color="#668B5CF6" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Orb body -->
    <path android:pathData="M54,54m-23,0a23,23 0,1 1,46 0a23,23 0,1 1,-46 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="47.5"
                android:centerY="46.5"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#FFE4FFF5" android:offset="0" />
                <item android:color="#FF5EEAD4" android:offset="0.24" />
                <item android:color="#FF2DD4BF" android:offset="0.46" />
                <item android:color="#FF6D5BF0" android:offset="0.65" />
                <item android:color="#FF8B5CF6" android:offset="0.78" />
                <item android:color="#FF33204F" android:offset="0.93" />
                <item android:color="#FF1E1030" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular highlight -->
    <path android:pathData="M47,46.4m-6.4,0a6.4,6.4 0,1 1,12.8 0a6.4,6.4 0,1 1,-12.8 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="47"
                android:centerY="46.4"
                android:gradientRadius="6.4"
                android:type="radial">
                <item android:color="#D9FFFFFF" android:offset="0" />
                <item android:color="#40FFFFFF" android:offset="0.62" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Front half of the orbit ring (in front of the orb) -->
    <path android:pathData="M26.5,53.5 A27.5,27.5 0 0 0 81.5,53.5"
        android:fillColor="#00000000"
        android:strokeLineCap="round"
        android:strokeWidth="3.3">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="82.5"
                android:endY="60"
                android:startX="25.5"
                android:startY="60"
                android:type="linear">
                <item android:color="#FF5EEAD4" android:offset="0" />
                <item android:color="#FF8B5CF6" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Amber comet at -45° on the ring, plus a fading trail dot at -24° -->
    <path android:pathData="M73.4,33.9m-6.6,0a6.6,6.6 0,1 1,13.2 0a6.6,6.6 0,1 1,-13.2 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="73.4"
                android:centerY="33.9"
                android:gradientRadius="6.6"
                android:type="radial">
                <item android:color="#55FBBF24" android:offset="0" />
                <item android:color="#1AFBBF24" android:offset="0.6" />
                <item android:color="#00FBBF24" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#FFFBBF24" android:pathData="M73.4,33.9m-3.1,0a3.1,3.1 0,1 1,6.2 0a3.1,3.1 0,1 1,-6.2 0" />
    <path android:fillColor="#8CFBBF24" android:pathData="M79.1,42.3m-1.6,0a1.6,1.6 0,1 1,3.2 0a1.6,1.6 0,1 1,-3.2 0" />

    <!-- One 4-pointed spark, upper-left of the orb -->
    <path android:pathData="M36.2,27.3 Q36.81,30.69 40.2,31.3 Q36.81,31.91 36.2,35.3 Q35.59,31.91 32.2,31.3 Q35.59,30.69 36.2,27.3 Z"
        android:fillColor="#F5FFFFFF" />
</vector>
